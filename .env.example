# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Server-only (ห้ามใส่ NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Drive (เฟส 4) — ดู docs/google-drive-setup.md แล้วกดเชื่อมต่อในหน้า ตั้งค่า ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- สำรองข้อมูลอัตโนมัติทุกคืน (สุ่มข้อความยาว ๆ อะไรก็ได้) ---
CRON_SECRET=

# --- LINE (เฟส 5 ยังไม่ต้องใส่) ---
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_MODE=mock
